include "test"
| include "sparkline"
|

# -- Basic Rendering --

def test_sparkline_full_range():
  let result = sparkline([1, 2, 3, 4, 5, 6, 7, 8])
  | assert_eq(result, "▁▂▃▄▅▆▇█")
end

def test_sparkline_two_values():
  let result = sparkline([1, 8])
  | assert_eq(result, "▁█")
end

def test_sparkline_shape():
  let result = sparkline([1, 5, 2, 8, 3, 9, 1, 7])
  | assert_eq(result, "▁▅▂▇▃█▁▆")
end

def test_sparkline_length_matches_input():
  let result = sparkline([3, 1, 4, 1, 5, 9, 2, 6])
  | assert_eq(len(to_array(result)), 8)
end

# -- Edge Cases --

def test_sparkline_empty_array():
  let result = sparkline([])
  | assert_eq(result, "")
end

def test_sparkline_single_value():
  let result = sparkline([42])
  | assert_eq(result, "▅")
end

def test_sparkline_all_values_equal():
  let result = sparkline([7, 7, 7, 7])
  | assert_eq(result, "▅▅▅▅")
end

def test_sparkline_all_zero():
  let result = sparkline([0, 0, 0])
  | assert_eq(result, "▅▅▅")
end

# -- Negative Numbers --

def test_sparkline_negative_and_positive():
  let result = sparkline([-5, 0, 5, -3, 3])
  | assert_eq(result, "▁▅█▂▇")
end

def test_sparkline_all_negative():
  let result = sparkline([-8, -1, -5, -2])
  | assert_eq(result, "▁█▄▇")
end

def test_sparkline_negative_flat():
  let result = sparkline([-4, -4, -4])
  | assert_eq(result, "▅▅▅")
end

# -- Floats --

def test_sparkline_floats():
  let result = sparkline([0.1, 0.5, 0.9])
  | assert_eq(result, "▁▅█")
end

# -- Errors --

def test_sparkline_non_number_element_errors():
  let result = try: sparkline([1, "two", 3]) catch: "caught"
  | assert_eq(result, "caught")
end

def test_sparkline_none_element_errors():
  let result = try: sparkline([1, None, 3]) catch: "caught"
  | assert_eq(result, "caught")
end

# -- Helper Function Tests --

def test_spark_ticks_has_eight_levels():
  assert_eq(len(_spark_ticks()), 8)
end

def test_spark_level_min_maps_to_zero():
  assert_eq(_spark_level(0, 0, 10, 8), 0)
end

def test_spark_level_max_maps_to_last():
  assert_eq(_spark_level(10, 0, 10, 8), 7)
end

def test_spark_level_flat_maps_to_middle():
  assert_eq(_spark_level(5, 5, 5, 8), 4)
end

def test_spark_level_midpoint():
  assert_eq(_spark_level(5, 0, 10, 8), 4)
end

# -- Realistic Example --

def test_sparkline_commit_counts():
  let result = sparkline([3, 5, 2, 8, 12, 4, 6])
  | assert_eq(result, "▂▃▁▅█▂▄")
end
